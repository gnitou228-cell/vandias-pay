# ========================================================
# VANDIAS PAY — FICHIER MODÈLE D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier vers .env et renseignez vos véritables valeurs
# ========================================================

# 1. Configuration du Serveur
PORT=3000
NODE_ENV=development
PLATFORM_FEE_PERCENT=2.5

# 2. Clés Supabase (À copier depuis votre dashboard Supabase > Settings > API)
# Si laissé vide ou avec des valeurs d'exemple, VandiasPay fonctionne automatiquement en base locale
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
JWT_SECRET=vandiaspay_super_secret_jwt_key_2026

# 3. Passerelle de Paiement sous-jacente (FedaPay ou Mode Simulation)
# Mettre "sandbox" pour tester gratuitement, puis "live" pour le vrai argent
PAYMENT_MODE=sandbox

# Clés FedaPay (créées gratuitement sur https://fedapay.com)
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxx
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxxxxx

# Clé Wave (Optionnel si vous utilisez Wave Business direct https://business.wave.com)
WAVE_API_KEY=
WAVE_API_SECRET=

# Optionnel : Opérateurs direct additionnels (si non routés par FedaPay)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
CINPAY_API_KEY=
