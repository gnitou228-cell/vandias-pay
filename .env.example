# ========================================================
# VANDIAS PAY — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier vers .env et renseignez vos véritables clés
# ========================================================

# Port d'écoute du serveur Express (Local ou Hébergement Cloud)
PORT=4173

# Environnement d'exécution ('development' ou 'production')
NODE_ENV=development

# URL publique de votre application (pour les redirections et liens de paiement absolus)
APP_URL=http://localhost:4173

# Clé secrète JWT pour la signature des sessions marchands (min. 32 caractères)
JWT_SECRET=vandias_jwt_secret_fintech_secure_key_2026_xyz987

# ========================================================
# SUPABASE DATABASE (POSTGRESQL CLOUD)
# Rendez-vous sur https://supabase.com > Project Settings > API
# ========================================================
# URL de votre projet Supabase (ex: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clé Secrète de Service Supabase (service_role secret)
# ATTENTION : Ne JAMAIS exposer côté client ou dans un dépôt public !
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ========================================================
# COMMISSIONS & FRAIS DE PLATEFORME
# ========================================================
# Pourcentage de commission prélevé par transaction réussie (2.5% par défaut)
PLATFORM_FEE_PERCENT=2.5

# Timeout des Webhooks en millisecondes
WEBHOOK_TIMEOUT_MS=5000

# ========================================================
# MODULE DES PASSERELLES DE PAIEMENT (GATEWAYS)
# Mode: 'sandbox' (simulation instantanée sans compte) ou 'live' (opérateurs réels)
# ========================================================
GATEWAY_MODE=sandbox

# --- 1. WAVE BUSINESS API (Sénégal, Côte d'Ivoire, Mali, Burkina) ---
# Obtenez vos clés sur le portail Wave Business : https://business.wave.com
WAVE_API_KEY=wave_ci_live_sample_key_xxxxxxxxxxxxx
WAVE_API_SECRET=wave_sec_sample_key_yyyyyyyyyyyyy
WAVE_BASE_URL=https://api.wave.com

# --- 2. ORANGE MONEY WEB PAYMENT ---
# Portail Orange Developer : https://developer.orange.com
ORANGE_MONEY_CLIENT_ID=om_client_id_sample_xxxxxxxx
ORANGE_MONEY_CLIENT_SECRET=om_client_secret_sample_yyyyyyyy
ORANGE_MONEY_MERCHANT_KEY=om_merchant_key_zzzzzzzz

# --- 3. MTN MOBILE MONEY (MoMo API Open API) ---
# Portail MTN MoMo API : https://momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=mtn_subscription_key_xxxxxxxx
MTN_MOMO_API_USER=mtn_api_user_uuid_xxxxxxxx
MTN_MOMO_API_KEY=mtn_api_key_xxxxxxxx
MTN_MOMO_ENVIRONMENT=sandbox

# --- 4. CONNECTEUR AGGRÉGATEUR (CINPAY / FEDAPAY POUR MOOV & CARTES VISA/MASTERCARD) ---
# CinetPay : https://cinetpay.com
CINPAY_API_KEY=cinetpay_api_key_sample_xxxxxxxx
CINPAY_SITE_ID=123456
# FedaPay : https://fedapay.com
FEDAPAY_SECRET_KEY=sk_live_fedapay_sample_xxxxxxxx
FEDAPAY_ENVIRONMENT=sandbox
